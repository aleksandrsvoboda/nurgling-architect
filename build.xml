<?xml version="1.0" ?>
<!-- Nurgling Architect: offline base planner on a pinned copy of the nurgling engine. -->
<project name="nurgling-architect" default="jar">
  <property name="nurgling.dir" value="../nurgling2"/>
  <property name="engine.dir" value="engine"/>
  <loadfile property="version" srcfile="VERSION"><filterchain><striplinebreaks/></filterchain></loadfile>

  <path id="engine.cp">
    <fileset dir="${engine.dir}" includes="*.jar"/>
  </path>

  <target name="check-engine">
    <available file="${engine.dir}/hafen.jar" property="engine.present"/>
    <fail unless="engine.present" message="No engine in ${engine.dir}. Run 'ant sync-engine' (copies ${nurgling.dir}/bin/*.jar)."/>
  </target>

  <!-- Copies the built client jars. Deliberate: the planner only moves to a newer engine when you ask. -->
  <target name="sync-engine">
    <!-- Only what the planner runs on (Windows): the client, its resource jars, and the GL/Vulkan toolkits.
         The game's database, Steam and other platforms' natives are left out. -->
    <delete>
      <fileset dir="${engine.dir}" includes="*.jar"/>
    </delete>
    <copy todir="${engine.dir}" overwrite="true">
      <fileset dir="${nurgling.dir}/bin">
        <include name="hafen.jar"/>
        <include name="builtin-res.jar"/>
        <include name="hafen-res.jar"/>
        <include name="nurgling-res.jar"/>
        <include name="json-java.jar"/>
        <include name="jogl-all.jar"/>
        <include name="jogl-all-natives-windows-amd64.jar"/>
        <include name="gluegen-rt.jar"/>
        <include name="gluegen-rt-natives-windows-amd64.jar"/>
        <include name="lwjgl-fat.jar"/>
        <include name="lwjgl-awt.jar"/>
        <include name="lwjgl-opengl-fat.jar"/>
        <exclude name="*-natives-linux*.jar"/>
        <exclude name="*-natives-macos*.jar"/>
      </fileset>
    </copy>
    <exec executable="git" dir="${nurgling.dir}" outputproperty="engine.rev" failifexecutionfails="false">
      <arg line="rev-parse --short HEAD"/>
    </exec>
    <exec executable="git" dir="${nurgling.dir}" outputproperty="engine.branch" failifexecutionfails="false">
      <arg line="rev-parse --abbrev-ref HEAD"/>
    </exec>
    <echo file="${engine.dir}/ENGINE_VERSION">${engine.rev} ${engine.branch}${line.separator}</echo>
    <echo message="Engine synced from ${nurgling.dir} at ${engine.rev} (${engine.branch})"/>
  </target>

  <target name="compile" depends="check-engine">
    <mkdir dir="build/classes"/>
    <javac srcdir="src" destdir="build/classes" includeantruntime="false" encoding="UTF-8" release="21" debug="true">
      <classpath refid="engine.cp"/>
      <compilerarg value="-Xlint:-options"/>
    </javac>
    <copy todir="build/classes">
      <fileset dir="src" excludes="**/*.java"/>
      <fileset dir="${engine.dir}" includes="ENGINE_VERSION"/>
    </copy>
    <copy file="VERSION" todir="build/classes/architect" overwrite="true"/>
  </target>

  <target name="jar" depends="compile">
    <jar destfile="app/architect.jar" basedir="build/classes">
      <manifest>
        <attribute name="Main-Class" value="architect.Main"/>
        <attribute name="Class-Path" value="../engine/hafen.jar"/>
        <attribute name="Add-Exports" value="java.base/java.lang java.desktop/sun.awt java.desktop/sun.java2d"/>
        <attribute name="Enable-Native-Access" value="ALL-UNNAMED"/>
      </manifest>
    </jar>
  </target>

  <!-- The release zip the Nurgling updater installs: the planner, its engine and app.json (how to start it).
       No runtime/: the updater starts it on Nurgling's own bundled Java. -->
  <target name="dist" depends="jar">
    <mkdir dir="dist"/>
    <delete file="dist/NurglingArchitect-${version}.zip"/>
    <zip destfile="dist/NurglingArchitect-${version}.zip" level="9">
      <zipfileset dir="app" includes="architect.jar" prefix="app"/>
      <zipfileset dir="${engine.dir}" prefix="engine"/>
      <fileset dir="." includes="app.json,run.bat,README.md,VERSION"/>
    </zip>
    <echo message="dist/NurglingArchitect-${version}.zip"/>
  </target>

  <target name="test-compile" depends="compile">
    <mkdir dir="build/test-classes"/>
    <javac srcdir="test" destdir="build/test-classes" includeantruntime="false" encoding="UTF-8" release="21" debug="true">
      <classpath><path refid="engine.cp"/><pathelement location="build/classes"/></classpath>
    </javac>
  </target>

  <!-- Plain-main tests (no junit dependency): each test class exits non-zero on failure. -->
  <target name="test" depends="test-compile">
    <java classname="architect.TestAll" fork="true" failonerror="true" dir=".">
      <classpath><path refid="engine.cp"/><pathelement location="build/classes"/><pathelement location="build/test-classes"/></classpath>
      <jvmarg value="-Djava.awt.headless=true"/>
    </java>
  </target>

  <target name="run" depends="jar">
    <java jar="app/architect.jar" fork="true" dir=".">
      <jvmarg value="-Dsun.java2d.uiScale.enabled=false"/>
      <jvmarg value="-Dhaven.prefspec=architect"/>
      <jvmarg value="--add-exports=java.base/java.lang=ALL-UNNAMED"/>
      <jvmarg value="--add-exports=java.desktop/sun.awt=ALL-UNNAMED"/>
      <jvmarg value="--add-exports=java.desktop/sun.java2d=ALL-UNNAMED"/>
      <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
      <jvmarg value="-Xss8m"/>
      <jvmarg value="-Xmx4096m"/>
    </java>
  </target>

  <!-- The bundled Java (runtime/), so the planner runs on PCs without Java. Needs a JDK 21 with jlink. -->
  <target name="runtime">
    <delete dir="runtime"/>
    <exec executable="jlink" failonerror="true">
      <arg line="--add-modules java.base,java.desktop,java.datatransfer,java.prefs,java.logging,java.management,java.naming,java.net.http,java.scripting,java.sql,java.xml,jdk.unsupported,jdk.crypto.ec,jdk.zipfs,jdk.charsets"/>
      <arg line="--strip-debug --no-header-files --no-man-pages --compress=zip-9 --output runtime"/>
    </exec>
  </target>

  <target name="clean">
    <delete dir="build"/>
  </target>
</project>
